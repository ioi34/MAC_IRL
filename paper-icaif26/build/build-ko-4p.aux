\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces 복원된 계수의 안정성과 두 합성 대조. 회색 점은 45개 개별 CPCV 분할, 굵은 선은 분할 간 표준편차, 옅은 선은 달력월 블록 부트스트랩 95\% 신뢰구간이다. 속이 빈 표식은 신뢰구간이 0을 포함하는 항이다. 회색 띠는 V5a 무선호 95\% 대역, 보라 띠는 개인 모멘텀ㆍ두 컨텍스트에 대한 V5b 조건부 청산 95\% 대역이며, 오른쪽 숫자는 45개 분할의 평균 계수다.\relax }}{3}{figure.caption.3}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:forest}{{1}{3}{복원된 계수의 안정성과 두 합성 대조. 회색 점은 45개 개별 CPCV 분할, 굵은 선은 분할 간 표준편차, 옅은 선은 달력월 블록 부트스트랩 95\% 신뢰구간이다. 속이 빈 표식은 신뢰구간이 0을 포함하는 항이다. 회색 띠는 V5a 무선호 95\% 대역, 보라 띠는 개인 모멘텀ㆍ두 컨텍스트에 대한 V5b 조건부 청산 95\% 대역이며, 오른쪽 숫자는 45개 분할의 평균 계수다.\relax }{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces 투자자별 실제 행동과 CPCV 표본외 예측 행동. 각 날짜의 9개 CPCV 시험예측을 먼저 평균한 뒤 실제값과 예측값에 20거래일 이동평균을 적용했다. 패널 제목의 표본외 $R^2$는 평활 전 일별 예측에 대한 45개 분할 평균으로 표\nonbreakingspace \ref  {tab:performance}와 같다.\relax }}{3}{figure.caption.5}\protected@file@percent }
\newlabel{fig:prediction}{{2}{3}{투자자별 실제 행동과 CPCV 표본외 예측 행동. 각 날짜의 9개 CPCV 시험예측을 먼저 평균한 뒤 실제값과 예측값에 20거래일 이동평균을 적용했다. 패널 제목의 표본외 $R^2$는 평활 전 일별 예측에 대한 45개 분할 평균으로 표~\ref {tab:performance}와 같다.\relax }{figure.caption.5}{}}
